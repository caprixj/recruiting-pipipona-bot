# --- Python Core ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribution / Poetry ---
# We commit poetry.lock, but ignore build artifacts
dist/
build/
*.egg-info/
.eggs/

# --- Environments (Strict Security) ---
# Never commit virtual envs or secrets
.env
.env.*
!.env.example
.venv/
env/
venv/

# --- Logs ---
*.log
logs/

# --- Testing & Quality Assurance ---
# Artifacts from Mypy, Ruff, and Pytest
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- IDE Settings ---
# PyCharm
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace

# --- Database & Docker ---
# Ignore local volume data to prevent committing the database itself
postgres_data/
*.sqlite3
*.db

# --- Project Specific ---
# Temporary output from utility scripts
scripts/output/

# --- OS Specific ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/